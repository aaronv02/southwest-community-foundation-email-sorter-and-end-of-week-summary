{
  "name": "inbox-steward",
  "version": "0.1.0",
  "private": true,
  "description": "Outlook add-in that categorizes mail with a three-layer classifier and promotes confident senders into native Outlook rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run.ts",
    "test:llm": "tsx test/run.ts --llm"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/office-js": "^1.0.377",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
